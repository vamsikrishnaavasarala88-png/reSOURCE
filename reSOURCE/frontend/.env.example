# Copy to `.env` (never commit the real file).

# Base URL of the reSOURCE API.
# - Leave this value as-is to call the backend directly (CORS is configured).
# - Remove the line (or set it to an empty value) to use the Vite dev proxy,
#   which forwards same-origin `/api` requests to VITE_PROXY_TARGET.
VITE_API_BASE_URL=http://localhost:8080/api

# Only used by the Vite dev proxy when VITE_API_BASE_URL is empty.
VITE_PROXY_TARGET=http://localhost:8080
