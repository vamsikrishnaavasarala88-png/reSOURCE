# Copy to `.env` in the project root (for docker-compose) and to `backend/.env`
# (loaded automatically by Spring Boot). Never commit the real file.

# ---------- PostgreSQL ----------
POSTGRES_DB=resource_db
POSTGRES_USER=resource_user
POSTGRES_PASSWORD=resource_pass

# Where the database runs. Use `postgres` instead of `localhost` if the
# backend is itself running inside the compose network.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------- Backend ----------
SERVER_PORT=8080

# Comma separated list of frontend origins allowed to call the API.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Optional. Use when the frontend host is not fixed, for example behind a
# reverse proxy or a preview/tunnel URL. Comma separated, wildcards allowed:
# CORS_ALLOWED_ORIGIN_PATTERNS=https://*.example.com,http://localhost:*
CORS_ALLOWED_ORIGIN_PATTERNS=

# ---------- JWT ----------
# Signing secret for access tokens. REQUIRED - the backend will not start
# without it, and it must be at least 32 characters (256 bits) for HS256.
# Generate one with:  openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Access token lifetime in minutes.
JWT_EXPIRATION_MINUTES=120

# ---------- Space photo storage ----------
# `local` writes uploads to the directory below and serves them from
# STORAGE_PUBLIC_PATH. A hosted provider can be added later.
STORAGE_TYPE=local
STORAGE_LOCAL_DIR=uploads/spaces
STORAGE_PUBLIC_PATH=/api/files/spaces
STORAGE_MAX_FILE_BYTES=5242880

# ---------- Demo data (development only) ----------
# true seeds a demo owner (SEED_DEMO_EMAIL / SEED_DEMO_PASSWORD) and a few
# example spaces on startup. Keep false outside development.
SEED_DEMO_DATA=false
SEED_DEMO_EMAIL=demo@resource.local
SEED_DEMO_PASSWORD=DemoPass123

# ---------- PostgreSQL-only migrations ----------
# Extra migration folder for SQL the tests' H2 database cannot run (the booking
# overlap exclusion constraint). Leave it unset on other engines.
FLYWAY_LOCATIONS=classpath:db/migration,classpath:db/migration-postgresql

# ---------- AI intelligence layer (Phase 6) ----------
# Key for the AI provider. Leave empty to run without AI: the marketplaces and
# every manual path keep working and the AI features answer with their fallback
# message. The key is used by the backend only and is never exposed to the
# frontend. Never commit a real key.
AI_API_KEY=
# Any OpenAI-compatible endpoint. AI_MODEL must support JSON output, and vision
# as well if image recognition is used (for example gpt-4o-mini).
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional tuning.
AI_READ_TIMEOUT_MS=20000
AI_SEARCH_REQUESTS_PER_MINUTE=20
AI_LISTING_REQUESTS_PER_MINUTE=30
AI_CACHE_TTL_SECONDS=300
